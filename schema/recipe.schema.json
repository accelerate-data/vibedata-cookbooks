{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/accelerate-data/vibedata-cookbooks/schema/recipe.schema.json",
  "title": "VibeData Recipe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "trigger",
    "description",
    "job_category",
    "area",
    "readiness",
    "prompt",
    "verified_by",
    "agent_guidance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": { "type": "string", "minLength": 1 },
    "trigger": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "description": { "type": "string", "minLength": 1 },
    "prompt": { "type": "string", "minLength": 1 },
    "job_category": {
      "enum": [
        "get-running",
        "re-engineer",
        "build",
        "prove",
        "explain",
        "cross-platform"
      ]
    },
    "area": {
      "type": "string",
      "minLength": 1
    },
    "readiness": {
      "enum": ["proven", "supported", "planned"]
    },
    "function": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "industry": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "domain_objects": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "works_with": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platforms": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "fabric_lakehouse",
              "fabric_warehouse",
              "motherduck",
              "duckdb"
            ]
          }
        },
        "tools": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "qualifiers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "verified_by": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "agent_guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instructions"],
      "properties": {
        "instructions": { "type": "string", "minLength": 1 },
        "compose": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "ask_first": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "guardrails": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "related": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "features": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "evals": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
